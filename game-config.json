{
  "version": "6.9.0-clean-local",
  "canonical_source": true,
  "arena": {
    "half_width": 16.5,
    "half_height": 10.5,
    "width": 33,
    "height": 21
  },
  "spawn": {
    "axis": "horizontal_x",
    "p1_x": -12.0,
    "p2_x": 12.0,
    "z": 0
  },
  "camera": {
    "default": "shared_top_down",
    "alternate": "split_chase_3d",
    "top_down_center": "exact_player_midpoint",
    "split": "50_50",
    "physical_resolution_layout": false,
    "visual_viewport_layout": false
  },
  "p2": {
    "ui_rotated_180": true,
    "input_inverted_globally": false,
    "input_camera_mapped_in_split": true
  },
  "assets": {
    "characters": "./assets/models/characters/",
    "weapons": "./assets/models/weapons/",
    "stage": "./assets/models/stage/",
    "local_repo_assets": true
  },
  "service_worker_cache": false,
  "build_limit": 10,
  "features": {
    "custom_loadout": true,
    "defense_system": true,
    "weapon_identity": true,
    "super_identity": true,
    "power_core": true,
    "sudden_death": true,
    "player_collision": true,
    "combat_feedback": true,
    "countdown_voice": true,
    "detailed_result": true
  },
  "canonical_functions": {
    "top_camera": "updateTopCamera",
    "split_camera": "updateChaseCamera",
    "split_renderer": "renderSplitArena",
    "input_mapping": "screenVectorToWorld"
  }
}
